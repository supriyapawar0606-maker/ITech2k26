# MongoDB connection string (use MongoDB Atlas for production — see deployment guide)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/quizarena

# Secret used to sign JWT auth tokens — use a long random string in production
JWT_SECRET=replace_with_a_long_random_string

# Optional — how long a login token stays valid (default: 1d)
JWT_EXPIRES_IN=1d

# Optional — port the server listens on (most hosts set this automatically)
PORT=5000

# Comma-separated list of frontend URLs allowed to call this API in production
# e.g. ALLOWED_ORIGINS=https://quizarena.vercel.app,https://www.yourdomain.com
ALLOWED_ORIGINS=
